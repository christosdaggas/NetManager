{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Network Manager Workspace",
  "version": "1.0.0",
  "identifier": "com.chrisdaggas.network-manager.workspace",
  "build": { "frontendDist": "../desktop" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Network Manager",
        "decorations": false,
        "width": 1060,
        "height": 680,
        "minWidth": 550,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "workspace",
          "windows": ["main", "utility-*"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-minimize",
            "core:window:allow-close"
          ]
        }
      ]
    }
  },
  "bundle": { "active": true, "targets": ["rpm", "deb"], "icon": ["icons/icon.png"] }
}
